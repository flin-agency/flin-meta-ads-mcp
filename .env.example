# Either use browser login or supply a token manually.
META_ACCESS_TOKEN=
# Browser login prompts for these if they are not set.
META_APP_ID=
# Optional: App-Geheimcode / App Secret for the app that issued the access token
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8765/callback
# Optional Facebook Login for Business configuration (user access token, ads_read)
META_LOGIN_CONFIG_ID=
# Optional override for the local credentials file; use the same path in the MCP client
# META_AUTH_FILE=/absolute/path/credentials.json
META_GRAPH_API_VERSION=v21.0
META_TIMEOUT_SECONDS=30
META_MAX_RETRIES=3
RUN_LIVE_META_TESTS=0
